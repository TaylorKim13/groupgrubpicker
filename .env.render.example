# Enter the team's actual values privately in Render. Do not commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional: only if you are enabling maps/place search.
# GOOGLE_MAPS_API_KEY=your-server-google-key
# VITE_GOOGLE_MAPS_BROWSER_KEY=your-browser-google-key
# Existing VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY is also supported.
# LOVABLE_API_KEY=your-existing-gateway-key-if-you-want-to-keep-the-gateway

# Optional: your canonical custom domain after you attach it in Render.
# PUBLIC_SITE_URL=https://groupgrub.example.com
# Render's own public URL is used automatically when this is absent.
